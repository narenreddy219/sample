import bsh.Interpreter
import java.math.BigDecimal

object AdvancedCalculationTest extends App {

  val uiExpression =
    """VALUE_AMOUNT == null || VALUE_AMOUNT.trim().equals("")
      |? null
      |: new java.math.BigDecimal(
      |    VALUE_AMOUNT.replace("$", "").replace(",", "").trim()
      |  ).setScale(2, java.math.RoundingMode.HALF_UP)""".stripMargin

  val testCases = Seq(
    ("$1,234.56",       "1234.56"),
    (" $7,890.12 ",     "7890.12"),
    ("$0.00",           "0.00"),
    ("  $0.00  ",       "0.00"),
    ("$123456789.99",   "123456789.99"),
    (" $987654321.01 ", "987654321.01"),
    ("$-1234.56",       "-1234.56"),
    (" $-7890.12 ",     "-7890.12"),
    ("$-0.00",          "0.00"),
    ("",                 null),
    (null,               null)
  )

  testCases.foreach {
    case (inputValue, expectedValue) =>
      try {
        // Create and bind for every test case
        val interpreter = new Interpreter()
        interpreter.set("VALUE_AMOUNT", inputValue)

        // Evaluate directly—no [VALUE_AMOUNT] replacement
        val result = interpreter.eval(uiExpression)

        val actualValue =
          Option(result)
            .map(_.asInstanceOf[BigDecimal].toPlainString)
            .orNull

        assert(
          actualValue == expectedValue,
          s"FAILED: input=[$inputValue], expected=[$expectedValue], actual=[$actualValue]"
        )

        println(
          s"PASSED: input=[$inputValue], result=[$actualValue]"
        )

      } catch {
        case ex: Exception =>
          println(
            s"FAILED: input=[$inputValue], error=${ex.getMessage}"
          )
          throw ex
      }
  }

  println("All advanced-calculation test cases passed.")
}
